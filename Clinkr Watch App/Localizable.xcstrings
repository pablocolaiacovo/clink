{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, %@. Your buddy is thirsty." : {
      "comment" : "Water break nudge message. The two values are tonight's drinks and waters, like \"4 drinks\" and \"0 waters\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@. Tu compa tiene sed."
          }
        }
      }
    },
    "%lld drinks" : {
      "comment" : "VoiceOver label for tonight's count",
      "localizations" : {
