    "Adds the last drink again" : {
      "comment" : "VoiceOver hint for tapping the tally ring",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a sumar lo último"
          }
        }
      }
    },
    "Cheers! That's %lld." : {
      "comment" : "Undo toast after adding a drink",
      "localizations" : {
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "¡Salud! Va 1."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "¡Salud! Van %lld."
                }
              }
            }
          }
        }
      }
    },
    "Had one" : {
      "comment" : "Water break nudge button that logs a water",
      "localizations" : {
